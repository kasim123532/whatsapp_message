datasource db {
  provider = "sqlite"
  url      = "file:../data/database.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id         String   @id @default(uuid())
  phone      String?  @unique
  name       String?
  proxy      String?
  status     String   @default("DISCONNECTED") // "DISCONNECTED", "CONNECTING", "CONNECTED", "BANNED"
  // Draft profiles are created by the QR page before anything is scanned. They
  // are swept away if nobody ever links a phone to them.
  isDraft    Boolean  @default(false)
  lastError  String?
  todaySent  Int      @default(0)
  // Local calendar day (YYYY-MM-DD) that `todaySent` is counting. The scheduler
  // zeroes the counter as soon as it sees a day it doesn't recognise, so the
  // rollover survives restarts without needing a cron at midnight.
  todaySentDay String?
  dailyLimit Int      @default(0)
  totalSent  Int      @default(0)
  // Pacing is per account, not per campaign: an account that just sent is muted
  // until this moment, no matter which campaign wants to use it next.
  nextAvailableAt DateTime?
  // Stamped on every connect attempt. The janitor ages a never-linked profile
  // from here rather than `createdAt`, so refreshing the QR of an old row
  // restarts its clock instead of deleting it out from under the scan.
  lastAttemptAt DateTime?
  createdAt  DateTime @default(now())
}

model Proxy {
  id        String   @id @default(uuid())
  value     String   @unique // raw proxy string, e.g. host:port or host:port:user:pass
  createdAt DateTime @default(now())
}

model ContactGroup {
  id        String     @id @default(uuid())
  name      String
  subGroups SubGroup[]
  createdAt DateTime   @default(now())
}

model SubGroup {
  id        String       @id @default(uuid())
  name      String
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  createdAt DateTime     @default(now())
}

model Contact {
  id             String              @id @default(uuid())
  name           String?
  phone          String
  variables      String              @default("{}") // JSON string of variables
  whatsappStatus String              @default("unknown") // "unknown", "checking", "exists", "not_found"
  subGroupId     String
  subGroup       SubGroup            @relation(fields: [subGroupId], references: [id], onDelete: Cascade)
  campaigns      CampaignRecipient[]
  createdAt      DateTime            @default(now())
}

model Template {
  id        String   @id @default(uuid())
  name      String
  body      String
  variables String   @default("[]") // JSON array of string variable names
  createdAt DateTime @default(now())
}

model Campaign {
  id             String              @id @default(uuid())
  name           String
  phones         String              @default("[]") // JSON array of sender phone numbers (legacy, для отображения)
  accountIds     String              @default("[]") // JSON array of sender Account.id — основной идентификатор
  message        String
  groupName      String              // The name of the subgroup target
  groupId        String              // The ID of the subgroup target
  nextAction     DateTime?
  minInterval    Int                 @default(600)
  maxInterval    Int                 @default(1200)
  sendFrom       String              @default("08:00")
  sendTo         String              @default("20:00")
  sent           Int                 @default(0)
  pending        Int                 @default(0)
  failed         Int                 @default(0)
  isPaused       Boolean             @default(true)
  status         String              @default("DRAFT") // "DRAFT", "RUNNING", "PAUSED", "COMPLETED"
  recipients     CampaignRecipient[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt @default(now())
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // "PENDING", "SENDING", "SENT", "FAILED"
  // A send that fails goes back to PENDING with a later `nextAttemptAt` until
  // the attempts run out; only then does it become terminally FAILED.
  // SENDING = атомарный клейм: строка захвачена одним воркером, второй её не возьмёт.
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  // Кто и когда реально отправил + итоговый текст (после подстановки {{переменных}}).
  senderAccountId String?
  senderPhone     String?
  sentText        String?
  sentAt     DateTime?
  error      String?
  updatedAt  DateTime  @updatedAt @default(now())

  @@unique([campaignId, contactId])
}
